# Apps Script web app URL (doGet endpoint) — server-only, never exposed to browser
# Get it from: Apps Script editor → Deploy → Manage deployments → Web app URL
APPS_SCRIPT_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Google Form URL — public-facing, safe to expose to the browser
PUBLIC_FORM_URL=https://forms.gle/YOUR_FORM_ID
