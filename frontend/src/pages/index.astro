---
import {
  emptyIdeasPayload,
  fetchIdeas,
  type IdeasPayload,
} from '../lib/ideas';

const formUrl = import.meta.env.PUBLIC_FORM_URL;
let data: IdeasPayload = emptyIdeasPayload();
let dataUnavailable = false;

try {
  data = await fetchIdeas(import.meta.env.APPS_SCRIPT_API_URL);
} catch (error) {
  dataUnavailable = true;
  console.error('Page data error:', error);
}

const { ideas, stats } = data;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<!doctype html>
<html lang="sq">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Ide qytetare për Shqipërinë e Re, me proces transparent."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Ide për Shqipërinë e Re</title>
  </head>
  <body>
    <main>
      <aside class="temporary-note">
        <strong>Faqe provizore</strong>
        <span>
          Jemi duke punuar për të përgatitur faqen zyrtare të platformës.
        </span>
      </aside>

      <header class="hero">
        <img class="hero-flamingo hero-flamingo-left" src="/flamingo-decor.svg" alt="" />
        <div class="hero-content">
          <p class="label">
            Platformë qytetare
            <img src="/albania-flag.svg" alt="Flamuri shqiptar" />
          </p>
          <h1>Ide për Shqipërinë e Re</h1>
          <p class="intro">
            Lexo idetë e aprovuara, dërgo propozimin tënd dhe ndiq procesin me transparencë.
          </p>

          <div class="actions">
            {formUrl && (
              <a class="primary" href={formUrl} target="_blank" rel="noopener noreferrer">
                Dërgo një ide
              </a>
            )}
            <a
              class="discord"
              href="https://discord.gg/aUm4WhzEp"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19.5 5.3A17 17 0 0 0 15.3 4l-.5 1.1a15.4 15.4 0 0 0-5.6 0L8.7 4a17 17 0 0 0-4.2 1.3C1.8 9.2 1.1 13 1.5 16.8A17 17 0 0 0 6.7 19l1.3-1.8-1.8-.9.4-.3a12.3 12.3 0 0 0 10.8 0l.4.3-1.8.9 1.3 1.8a17 17 0 0 0 5.2-2.2c.5-4.4-.8-8.1-3-11.5ZM8.8 14.7c-1 0-1.9-1-1.9-2.2s.8-2.2 1.9-2.2 1.9 1 1.9 2.2-.9 2.2-1.9 2.2Zm6.4 0c-1 0-1.9-1-1.9-2.2s.8-2.2 1.9-2.2 1.9 1 1.9 2.2-.8 2.2-1.9 2.2Z"/>
              </svg>
              Bashkohu me ne ose jep idetë e tua
            </a>
          </div>
        </div>
        <img class="hero-flamingo hero-flamingo-right" src="/flamingo-decor.svg" alt="" />
      </header>

      <section class="stats" aria-label="Statistikat">
        <div><strong id="approved-count">{stats.approved}</strong><span>Ide të publikuara</span></div>
      </section>

      <section class="transparency">
        <span class="symbols" aria-hidden="true">
          <img src="/favicon.svg" alt="" />
          <img src="/albania-flag.svg" alt="" />
        </span>
        <div>
          <h2>Transparencë për çdo hap</h2>
          <p>
            Çdo informacion mbi procesin, idetë e publikuara dhe mënyrën e përpunimit
            do të bëhet transparent për komunitetin.
          </p>
        </div>
      </section>

      <section class="ideas-section">
        <div class="section-heading">
          <h2>Idetë e aprovuara</h2>
          <span class="live-status">
            <i aria-hidden="true"></i>
            Përditësohet automatikisht
          </span>
        </div>

        <div class="moderation-note">
          <span aria-hidden="true">✓</span>
          <p>
            Përpara publikimit, idetë kontrollohen automatikisht për gjuhë fyese,
            fjalor të papërshtatshëm, spam dhe të dhëna personale. Këtu shfaqen
            vetëm propozimet që kalojnë filtrimin.
          </p>
        </div>

        {dataUnavailable ? (
          <p id="ideas-notice" class="notice error" role="alert">
            Të dhënat nuk mund të ngarkohen. Kontrollo konfigurimin e API-së.
          </p>
        ) : ideas.length === 0 ? (
          <p id="ideas-notice" class="notice">Ende nuk ka ide të publikuara.</p>
        ) : (
          <div id="ideas-list" class="ideas">
            {ideas.map((item) => (
              <article class="idea-card">
                <p class="idea-text">{item.idea}</p>
                <button
                  class="idea-toggle"
                  type="button"
                  aria-expanded="false"
                  hidden
                >
                  Trego më shumë
                </button>
              </article>
            ))}
          </div>
        )}
      </section>

      <footer>
        <span class="footer-brand">
          <img src="/favicon.svg" alt="" />
          Ide për Shqipërinë e Re
          <img src="/albania-flag.svg" alt="" />
        </span>
        <span>Mos vendos të dhëna personale në propozimin tënd.</span>
      </footer>
    </main>

    <script>
      const approvedCount = document.querySelector('#approved-count');
      const ideasSection = document.querySelector('.ideas-section');

      function renderIdeas(items) {
        let list = document.querySelector('#ideas-list');
        let notice = document.querySelector('#ideas-notice');

        if (!Array.isArray(items) || items.length === 0) {
          list?.remove();
          if (!notice) {
            notice = document.createElement('p');
            notice.id = 'ideas-notice';
            notice.className = 'notice';
            ideasSection?.appendChild(notice);
          }
          notice.textContent = 'Ende nuk ka ide të publikuara.';
          return;
        }

        notice?.remove();
        if (!list) {
          list = document.createElement('div');
          list.id = 'ideas-list';
          list.className = 'ideas';
          ideasSection?.appendChild(list);
        }

        list.replaceChildren(
          ...items.map((item) => {
            const article = document.createElement('article');
            article.className = 'idea-card';
            const text = document.createElement('p');
            text.className = 'idea-text';

            text.textContent = typeof item.idea === 'string' ? item.idea : '';

            article.append(text);

            const toggle = document.createElement('button');
            toggle.className = 'idea-toggle';
            toggle.type = 'button';
            toggle.hidden = true;
            toggle.setAttribute('aria-expanded', 'false');
            toggle.textContent = 'Trego më shumë';
            article.append(toggle);

            return article;
          }),
        );

        requestAnimationFrame(updateIdeaToggles);
      }

      function updateIdeaToggles() {
        document.querySelectorAll('.idea-card').forEach((card) => {
          const text = card.querySelector('.idea-text');
          const toggle = card.querySelector('.idea-toggle');
          if (!(text instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) return;

          if (card.classList.contains('is-expanded')) {
            toggle.hidden = false;
            return;
          }

          toggle.hidden = text.scrollHeight <= text.clientHeight + 1;
        });
      }

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const toggle = target.closest('.idea-toggle');
        if (!(toggle instanceof HTMLButtonElement)) return;

        const card = toggle.closest('.idea-card');
        if (!card) return;

        const expanded = card.classList.toggle('is-expanded');
        toggle.setAttribute('aria-expanded', String(expanded));
        toggle.textContent = expanded ? 'Trego më pak' : 'Trego më shumë';
      });

      let resizeTimer;
      window.addEventListener('resize', () => {
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(updateIdeaToggles, 120);
      });

      updateIdeaToggles();
      document.fonts?.ready.then(updateIdeaToggles);

      async function refreshIdeas() {
        try {
          const response = await fetch('/api/ideas', { cache: 'no-store' });
          if (!response.ok) return;

          const data = await response.json();
          if (approvedCount) approvedCount.textContent = String(data.stats?.approved ?? 0);
          renderIdeas(data.ideas);
        } catch {
          // Mbaj të dhënat e fundit në ekran nëse një kërkesë dështon.
        }
      }

      window.setInterval(refreshIdeas, 10_000);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') refreshIdeas();
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    font-family: Inter, system-ui, sans-serif;
    color: #272323;
    background: #faf7f2;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at 10% 0%, rgba(205, 112, 116, .11), transparent 30rem),
      linear-gradient(180deg, #faf7f2 0%, #fff 58%, #faf7f2 100%);
  }

  main {
    width: min(920px, 92%);
    margin: auto;
    padding: 56px 0 32px;
  }

  .temporary-note {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
    padding: 12px 15px;
    color: #684247;
    background: #f5e7e4;
    border: 1px solid #e8d1cd;
    border-radius: 8px;
    font-size: 14px;
  }

  .temporary-note strong {
    flex: 0 0 auto;
    padding: 4px 8px;
    color: #fff;
    background: #9f4f55;
    border-radius: 999px;
    font-size: 12px;
  }

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 330px;
    padding: 42px 150px 58px;
    overflow: hidden;
    text-align: center;
    background:
      linear-gradient(rgba(255,255,255,.2), rgba(255,255,255,.2)),
      #f6e5e2;
    border: 1px solid #e8d1cd;
    border-radius: 16px;
    box-shadow: 0 18px 50px rgba(74, 46, 42, .07);
  }

  .hero::before,
  .hero::after {
    position: absolute;
    right: 0;
    left: 0;
    height: 14px;
    background: url('/albanian-pattern.svg') repeat-x center / auto 14px;
    content: "";
    opacity: .75;
  }

  .hero::before { top: 0; }
  .hero::after { bottom: 0; }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 620px;
  }

  .hero-flamingo {
    position: absolute;
    bottom: 22px;
    width: 145px;
    height: 245px;
    object-fit: contain;
    opacity: .88;
  }

  .hero-flamingo-left { left: 15px; }
  .hero-flamingo-right { right: 15px; transform: scaleX(-1); }

  .hero::selection {
    background: #d49a9c;
  }

  .label {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    color: #8f454c;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .label img,
  .footer-brand img {
    width: 25px;
    height: 25px;
    object-fit: contain;
  }

  .label img:last-child,
  .footer-brand img:last-child {
    width: 31px;
  }

  h1 {
    margin: 0;
    color: #7d343b;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(38px, 6vw, 62px);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -.025em;
  }

  .intro {
    margin: 14px 0 0;
    color: #6f5c59;
    font-size: 17px;
    line-height: 1.6;
  }

  .actions {
    display: flex;
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: 0 0 auto;
    padding: 12px 18px;
    border-radius: 9px;
    text-decoration: none;
    font-weight: 700;
    transition: transform .15s ease, box-shadow .15s ease;
  }

  .actions a:hover {
    transform: translateY(-1px);
  }

  .primary {
    color: white;
    background: #9f4f55;
    box-shadow: 0 8px 22px rgba(98, 47, 51, .14);
  }

  .discord {
    color: white;
    background: #4e5368;
  }

  .discord svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin: 28px 0;
  }

  .stats div,
  .idea-card,
  .notice {
    background: rgba(255, 255, 255, .88);
    border: 1px solid #e8ded5;
    border-radius: 10px;
    box-shadow: 0 8px 24px rgba(70, 53, 43, .045);
  }

  .stats div { padding: 18px; }
  .stats strong { display: block; color: #8f454c; font-size: 30px; }
  .stats span { color: #746963; font-size: 14px; }

  .transparency {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 0 0 48px;
    padding: 22px;
    color: #423a37;
    background: #f3eee7;
    border: 1px solid #e3d8cc;
    border-radius: 10px;
  }

  .symbols {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
  }

  .symbols img { width: 42px; height: 42px; object-fit: contain; }
  .symbols img:last-child { width: 52px; }
  .transparency h2 { margin-bottom: 6px; }
  .transparency p { margin: 0; color: #70655f; line-height: 1.55; }

  h2 {
    margin: 0 0 18px;
    color: #433b38;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 28px;
    font-weight: 500;
  }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }

  .section-heading h2 { margin: 0; }

  .moderation-note {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    margin-bottom: 18px;
    padding: 14px 16px;
    color: #5f5651;
    background: #f4f0e9;
    border: 1px solid #e2d9cf;
    border-radius: 9px;
    font-size: 13px;
    line-height: 1.55;
  }

  .moderation-note span {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    color: #fff;
    background: #79876f;
    border-radius: 50%;
    font-weight: 800;
  }

  .moderation-note p { margin: 0; }

  .live-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #756a64;
    font-size: 12px;
  }

  .live-status i {
    width: 8px;
    height: 8px;
    background: #2eb67d;
    border-radius: 50%;
    box-shadow: 0 0 0 4px rgba(46, 182, 125, .12);
  }

  .ideas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .idea-card {
    position: relative;
    overflow: hidden;
    min-height: 142px;
    padding: 22px 24px 20px;
    background: #fffdf9;
    border: 1px solid #ded4ca;
    border-radius: 11px;
    box-shadow: 0 10px 30px rgba(68, 50, 42, .06);
    transition: transform .15s ease, box-shadow .15s ease;
  }

  .idea-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 34px rgba(68, 50, 42, .09);
  }

  .idea-card::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: #b9676c;
    content: "";
  }

  .idea-text {
    margin: 0 0 22px;
    color: #2f2926;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 18px;
    line-height: 1.55;
  }

  .idea-card:not(.is-expanded) .idea-text {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
  }

  .idea-toggle {
    margin: -8px 0 16px;
    padding: 0;
    color: #8f454c;
    background: transparent;
    border: 0;
    cursor: pointer;
    font: inherit;
    font-size: 13px;
    font-weight: 750;
  }

  .idea-toggle[hidden] { display: none; }
  .idea-toggle:hover { text-decoration: underline; }

  .notice {
    padding: 24px;
    color: #67606b;
  }

  .error { border-color: #d99; color: #8b2525; }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid #e5dcd3;
    color: #746963;
    font-size: 13px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  @media (max-width: 650px) {
    main { padding-top: 24px; }
    .temporary-note { align-items: start; flex-direction: column; }
    .hero {
      min-height: 0;
      padding: 48px 24px 64px;
    }
    .hero-flamingo { width: 80px; height: 140px; opacity: .34; }
    .hero-flamingo-left { left: -10px; }
    .hero-flamingo-right { right: -10px; }
    .actions { width: 100%; }
    .actions a { width: 100%; }
    .stats, .ideas { grid-template-columns: 1fr; }
    .transparency { align-items: start; }
    .section-heading { align-items: start; flex-direction: column; }
    footer { flex-direction: column; }
  }
</style>
