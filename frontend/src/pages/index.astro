---
import {
  emptyIdeasPayload,
  fetchIdeas,
  type IdeasPayload,
} from '../lib/ideas';

const formUrl = import.meta.env.PUBLIC_FORM_URL;
let data: IdeasPayload = emptyIdeasPayload();
let dataUnavailable = false;

try {
  data = await fetchIdeas(import.meta.env.APPS_SCRIPT_API_URL);
} catch (error) {
  dataUnavailable = true;
  console.error('Page data error:', error);
}

const { ideas, stats } = data;
Astro.response.headers.set('Cache-Control', 's-maxage=30, stale-while-revalidate=60');
---

<!doctype html>
<html lang="sq">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Ide qytetare për Shqipërinë e Re, me proces transparent."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Ide për Shqipërinë e Re</title>
  </head>
  <body>
    <main>
      <header>
        <div>
          <p class="label"><span aria-hidden="true">🦩</span> Platformë qytetare <span aria-hidden="true">🇦🇱</span></p>
          <h1>Ide për Shqipërinë e Re</h1>
          <p class="intro">
            Lexo idetë e aprovuara, dërgo propozimin tënd dhe ndiq procesin me transparencë.
          </p>
        </div>

        <div class="actions">
          {formUrl && (
            <a class="primary" href={formUrl} target="_blank" rel="noopener noreferrer">
              Dërgo një ide
            </a>
          )}
          <a
            class="discord"
            href="https://discord.gg/aUm4WhzEp"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19.5 5.3A17 17 0 0 0 15.3 4l-.5 1.1a15.4 15.4 0 0 0-5.6 0L8.7 4a17 17 0 0 0-4.2 1.3C1.8 9.2 1.1 13 1.5 16.8A17 17 0 0 0 6.7 19l1.3-1.8-1.8-.9.4-.3a12.3 12.3 0 0 0 10.8 0l.4.3-1.8.9 1.3 1.8a17 17 0 0 0 5.2-2.2c.5-4.4-.8-8.1-3-11.5ZM8.8 14.7c-1 0-1.9-1-1.9-2.2s.8-2.2 1.9-2.2 1.9 1 1.9 2.2-.9 2.2-1.9 2.2Zm6.4 0c-1 0-1.9-1-1.9-2.2s.8-2.2 1.9-2.2 1.9 1 1.9 2.2-.8 2.2-1.9 2.2Z"/>
            </svg>
            Bashkohu me ne
          </a>
        </div>
      </header>

      <section class="stats" aria-label="Statistikat">
        <div><strong>{stats.approved}</strong><span>Të publikuara</span></div>
        <div><strong>{stats.rejected}</strong><span>Të filtruara</span></div>
      </section>

      <section class="transparency">
        <span class="symbol" aria-hidden="true">🦩 🇦🇱</span>
        <div>
          <h2>Transparencë për çdo hap</h2>
          <p>
            Çdo informacion mbi procesin, idetë e publikuara dhe mënyrën e përpunimit
            do të bëhet transparent për komunitetin.
          </p>
        </div>
      </section>

      <section class="ideas-section">
        <h2>Idetë e aprovuara</h2>

        {dataUnavailable ? (
          <p class="notice error" role="alert">
            Të dhënat nuk mund të ngarkohen. Kontrollo konfigurimin e API-së.
          </p>
        ) : ideas.length === 0 ? (
          <p class="notice">Ende nuk ka ide të publikuara.</p>
        ) : (
          <div class="ideas">
            {ideas.map((item) => (
              <article>
                <p>{item.idea}</p>
                <small>{item.name || 'Anonim'}</small>
              </article>
            ))}
          </div>
        )}
      </section>

      <footer>
        <span>🦩 Ide për Shqipërinë e Re 🇦🇱</span>
        <span>Mos vendos të dhëna personale në propozimin tënd.</span>
      </footer>
    </main>
  </body>
</html>

<style>
  :root {
    font-family: Inter, system-ui, sans-serif;
    color: #24212a;
    background: #f7f5f8;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
  }

  main {
    width: min(920px, 92%);
    margin: auto;
    padding: 56px 0 32px;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    padding-bottom: 32px;
    border-bottom: 1px solid #ddd7e1;
  }

  .label {
    margin: 0 0 8px;
    color: #7b3f78;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  h1 {
    margin: 0;
    font-size: clamp(34px, 6vw, 58px);
    line-height: 1;
  }

  .intro {
    margin: 14px 0 0;
    color: #67606b;
    font-size: 18px;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 176px;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: 0 0 auto;
    padding: 12px 18px;
    border-radius: 9px;
    text-decoration: none;
    font-weight: 700;
  }

  .primary {
    color: white;
    background: #713b70;
  }

  .discord {
    color: white;
    background: #5865f2;
  }

  .discord svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin: 28px 0;
  }

  .stats div,
  article,
  .notice {
    background: white;
    border: 1px solid #e3dee6;
    border-radius: 12px;
  }

  .stats div { padding: 18px; }
  .stats strong { display: block; font-size: 30px; }
  .stats span { color: #756e79; font-size: 14px; }

  .transparency {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 0 0 48px;
    padding: 22px;
    color: #fff;
    background: #24212a;
    border-radius: 12px;
  }

  .transparency .symbol {
    flex: 0 0 auto;
    font-size: 32px;
  }

  .transparency h2 { margin-bottom: 6px; }
  .transparency p { margin: 0; color: #ded9e1; line-height: 1.55; }

  h2 { margin: 0 0 18px; font-size: 26px; }

  .ideas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  article { padding: 20px; }
  article p { margin: 0 0 20px; line-height: 1.6; }
  article small { color: #756e79; }

  .notice {
    padding: 24px;
    color: #67606b;
  }

  .error { border-color: #d99; color: #8b2525; }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid #ddd7e1;
    color: #756e79;
    font-size: 13px;
  }

  @media (max-width: 650px) {
    header { align-items: start; flex-direction: column; }
    .actions { width: 100%; }
    .stats, .ideas { grid-template-columns: 1fr; }
    .transparency { align-items: start; }
    footer { flex-direction: column; }
  }
</style>
