---
import {
  emptyIdeasPayload,
  fetchIdeas,
  type IdeasPayload,
} from '../lib/ideas';

const formUrl = import.meta.env.PUBLIC_FORM_URL;
let data: IdeasPayload = emptyIdeasPayload();
let dataUnavailable = false;

try {
  data = await fetchIdeas(import.meta.env.APPS_SCRIPT_API_URL);
} catch (error) {
  dataUnavailable = true;
  console.error('Page data error:', error);
}

const { ideas, stats } = data;
Astro.response.headers.set('Cache-Control', 's-maxage=30, stale-while-revalidate=60');
---

<!doctype html>
<html lang="sq">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Ide qytetare për Shqipërinë e Re, me proces transparent."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Ide për Shqipërinë e Re</title>
  </head>
  <body>
    <main>
      <aside class="temporary-note">
        <strong>Faqe provizore</strong>
        <span>
          Jemi duke punuar për të përgatitur faqen zyrtare të platformës.
        </span>
      </aside>

      <header>
        <div>
          <p class="label">
            <img src="/favicon.svg" alt="" />
            Platformë qytetare
            <img src="/albania-flag.svg" alt="Flamuri shqiptar" />
          </p>
          <h1>Ide për Shqipërinë e Re</h1>
          <p class="intro">
            Lexo idetë e aprovuara, dërgo propozimin tënd dhe ndiq procesin me transparencë.
          </p>
        </div>

        <div class="actions">
          {formUrl && (
            <a class="primary" href={formUrl} target="_blank" rel="noopener noreferrer">
              Dërgo një ide
            </a>
          )}
          <a
            class="discord"
            href="https://discord.gg/aUm4WhzEp"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19.5 5.3A17 17 0 0 0 15.3 4l-.5 1.1a15.4 15.4 0 0 0-5.6 0L8.7 4a17 17 0 0 0-4.2 1.3C1.8 9.2 1.1 13 1.5 16.8A17 17 0 0 0 6.7 19l1.3-1.8-1.8-.9.4-.3a12.3 12.3 0 0 0 10.8 0l.4.3-1.8.9 1.3 1.8a17 17 0 0 0 5.2-2.2c.5-4.4-.8-8.1-3-11.5ZM8.8 14.7c-1 0-1.9-1-1.9-2.2s.8-2.2 1.9-2.2 1.9 1 1.9 2.2-.9 2.2-1.9 2.2Zm6.4 0c-1 0-1.9-1-1.9-2.2s.8-2.2 1.9-2.2 1.9 1 1.9 2.2-.8 2.2-1.9 2.2Z"/>
            </svg>
            Bashkohu me ne ose jep idetë e tua
          </a>
        </div>
      </header>

      <section class="stats" aria-label="Statistikat">
        <div><strong>{stats.approved}</strong><span>Të publikuara</span></div>
        <div><strong>{stats.rejected}</strong><span>Të filtruara</span></div>
      </section>

      <section class="transparency">
        <span class="symbols" aria-hidden="true">
          <img src="/favicon.svg" alt="" />
          <img src="/albania-flag.svg" alt="" />
        </span>
        <div>
          <h2>Transparencë për çdo hap</h2>
          <p>
            Çdo informacion mbi procesin, idetë e publikuara dhe mënyrën e përpunimit
            do të bëhet transparent për komunitetin.
          </p>
        </div>
      </section>

      <section class="ideas-section">
        <h2>Idetë e aprovuara</h2>

        {dataUnavailable ? (
          <p class="notice error" role="alert">
            Të dhënat nuk mund të ngarkohen. Kontrollo konfigurimin e API-së.
          </p>
        ) : ideas.length === 0 ? (
          <p class="notice">Ende nuk ka ide të publikuara.</p>
        ) : (
          <div class="ideas">
            {ideas.map((item) => (
              <article>
                <p>{item.idea}</p>
                <small>{item.name || 'Anonim'}</small>
              </article>
            ))}
          </div>
        )}
      </section>

      <footer>
        <span class="footer-brand">
          <img src="/favicon.svg" alt="" />
          Ide për Shqipërinë e Re
          <img src="/albania-flag.svg" alt="" />
        </span>
        <span>Mos vendos të dhëna personale në propozimin tënd.</span>
      </footer>
    </main>
  </body>
</html>

<style>
  :root {
    font-family: Inter, system-ui, sans-serif;
    color: #2d1726;
    background: #fff7fb;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at 8% 0%, rgba(255, 128, 190, .22), transparent 28rem),
      linear-gradient(180deg, #fff7fb 0%, #fff 55%, #fff8fb 100%);
  }

  main {
    width: min(920px, 92%);
    margin: auto;
    padding: 56px 0 32px;
  }

  .temporary-note {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 22px;
    padding: 12px 15px;
    color: #6d294f;
    background: #ffe4f1;
    border: 1px solid #ffc5df;
    border-radius: 12px;
    font-size: 14px;
  }

  .temporary-note strong {
    flex: 0 0 auto;
    padding: 4px 8px;
    color: #fff;
    background: #d93484;
    border-radius: 999px;
    font-size: 12px;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    padding-bottom: 32px;
    border-bottom: 1px solid #efd5e3;
  }

  .label {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    color: #b52f71;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  .label img,
  .footer-brand img {
    width: 25px;
    height: 25px;
    object-fit: contain;
  }

  .label img:last-child,
  .footer-brand img:last-child {
    width: 31px;
  }

  h1 {
    margin: 0;
    font-size: clamp(34px, 6vw, 58px);
    line-height: 1;
  }

  .intro {
    margin: 14px 0 0;
    color: #735467;
    font-size: 18px;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 248px;
  }

  .actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: 0 0 auto;
    padding: 12px 18px;
    border-radius: 9px;
    text-decoration: none;
    font-weight: 700;
    transition: transform .15s ease, box-shadow .15s ease;
  }

  .actions a:hover {
    transform: translateY(-1px);
  }

  .primary {
    color: white;
    background: linear-gradient(135deg, #e33b8d, #b52f71);
    box-shadow: 0 8px 22px rgba(181, 47, 113, .18);
  }

  .discord {
    color: white;
    background: #5865f2;
  }

  .discord svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin: 28px 0;
  }

  .stats div,
  article,
  .notice {
    background: rgba(255, 255, 255, .88);
    border: 1px solid #f0dce7;
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(92, 33, 65, .05);
  }

  .stats div { padding: 18px; }
  .stats strong { display: block; color: #c72f79; font-size: 30px; }
  .stats span { color: #806173; font-size: 14px; }

  .transparency {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 0 0 48px;
    padding: 22px;
    color: #57213f;
    background: linear-gradient(135deg, #ffe5f1, #fff3f8);
    border: 1px solid #ffcce3;
    border-radius: 14px;
  }

  .symbols {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
  }

  .symbols img { width: 42px; height: 42px; object-fit: contain; }
  .symbols img:last-child { width: 52px; }
  .transparency h2 { margin-bottom: 6px; }
  .transparency p { margin: 0; color: #765064; line-height: 1.55; }

  h2 { margin: 0 0 18px; font-size: 26px; }

  .ideas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  article {
    position: relative;
    overflow: hidden;
    padding: 22px;
  }

  article::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: linear-gradient(#f05ba0, #b52f71);
    content: "";
  }

  article p { margin: 0 0 20px; line-height: 1.6; }
  article small { color: #8a687a; }

  .notice {
    padding: 24px;
    color: #67606b;
  }

  .error { border-color: #d99; color: #8b2525; }

  footer {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid #efd5e3;
    color: #806173;
    font-size: 13px;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  @media (max-width: 650px) {
    main { padding-top: 24px; }
    .temporary-note { align-items: start; flex-direction: column; }
    header { align-items: start; flex-direction: column; }
    .actions { width: 100%; }
    .stats, .ideas { grid-template-columns: 1fr; }
    .transparency { align-items: start; }
    footer { flex-direction: column; }
  }
</style>
